@Entry
@Component
export default struct Index {

  @State mode: number = 0
  @State time: number = 25 * 60
  timer: number = -1

  @State inputMoney: string = ''
  @State selectedType: string = 'é¥®é£Ÿ'
  @State records: RecordItem[] = []

  aboutToAppear() {
    this.records = AppStorage.get<RecordItem[]>('records') ?? []
  }

  saveRecord() {
    if (this.inputMoney === '') {
      return
    }
    this.records.push({
      money: this.inputMoney,
      type: this.selectedType
    })
    AppStorage.set('records', this.records)
    this.inputMoney = ''
    this.selectedType = 'é¥®é£Ÿ'
    this.mode = 0
  }

  startPomodoro() {
    this.timer = setInterval(() => {
      if (this.time > 0) {
        this.time--
      } else {
        clearInterval(this.timer)
        this.time = 25 * 60
        this.mode = 0
      }
    }, 1000)
  }

  format(t: number): string {
    let m = Math.floor(t / 60)
    let s = t % 60
    return `${m}:${s < 10 ? '0' + s : s}`
  }

  build() {
    Column({ space: 20 }) {

      if (this.mode === 0) {
        Text('ä¸“æ³¨è´¦æœ¬')
          .fontSize(26)
          .fontWeight(FontWeight.Bold)

        Text(`å·²è®°è´¦ ${this.records.length} ç¬”`)
          .fontSize(16)

        if (this.records.length > 0) {
          Text(
            `æœ€è¿‘ï¼šÂ¥${this.records[this.records.length - 1].money}ï¼ˆ` +
              `${this.records[this.records.length - 1].type}ï¼‰`
          )
        }

        Button('å¼€å§‹ç•ªèŒ„é’Ÿ')
          .onClick(() => {
            this.mode = 1
            this.startPomodoro()
          })

        Button('è®°ä¸€ç¬”è´¦')
          .onClick(() => {
            this.mode = 2
          })
      }

      if (this.mode === 1) {
        Text('ç•ªèŒ„é’Ÿ')
          .fontSize(22)

        Text(this.format(this.time))
          .fontSize(36)

        Button('è¿”å›é¦–é¡µ')
          .onClick(() => {
            clearInterval(this.timer)
            this.time = 25 * 60
            this.mode = 0
          })
      }

      if (this.mode === 2) {
        Text('è®°è´¦')
          .fontSize(22)

        TextInput({
          placeholder: 'è¯·è¾“å…¥é‡‘é¢',
          text: this.inputMoney
        })
          .onChange((value: string) => {
            this.inputMoney = value
          })

        Text(`å½“å‰ç±»å‹ï¼š${this.selectedType}`)

        Button('é¥®é£Ÿ')
          .onClick(() => {
            this.selectedType = 'é¥®é£Ÿ'
          })

        Button('äº¤é€š')
          .onClick(() => {
            this.selectedType = 'äº¤é€š'
          })

        Button('å­¦ä¹ ')
          .onClick(() => {
            this.selectedType = 'å­¦ä¹ '
          })

        Button('å…¶ä»–')
          .onClick(() => {
            this.selectedType = 'å…¶ä»–'
          })

        Button('ä¿å­˜')
          .onClick(() => {
            this.saveRecord()
          })

        Button('å–æ¶ˆ')
          .onClick(() => {
            this.mode = 0
          })
      }
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
  }
}
